class NPC2:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.hp = 100
        self.run_anim_count = 0
        self.attack_anim_count = 0
        self.death_anim_count = 0
        self.state = "idle"
        self.rect = pygame.Rect(x, y, npc2_run_left[0].get_width(), npc2_run_left[0].get_height())

    def update(self):
        # Обновляем rect при изменении позиции
        self.rect.x = self.x
        self.rect.y = self.y

running = True
menu = True

while running:

    screen.fill((0, 0, 0))
    screen.blit(bg_menu, (0, 0))
    keys = pygame.key.get_pressed()

    if menu:
        font = pygame.font.SysFont('Arial', 36)
        text = font.render("Нажмите P для входа в игру!", True, (255, 255, 255))
        screen.blit(text, (400, 100))

        if keys[pygame.K_p]:
            menu = False
    else:

        screen.blit(bg, (bg_scroll % 1440, 0))
        screen.blit(bg, (bg_scroll % 1440 - 1440, 0))
        npc1_left_pos = 1

        font = pygame.font.SysFont('Arial', 22)
        hp_text = font.render(f"HP: {hp}", True, (255, 255, 255))
        screen.blit(hp_text, (50, 20))

        player_rect = pygame.Rect(player_x, player_y,
                                  walk_left[0].get_width(),
                                  walk_left[0].get_height())

        npc1_rect = pygame.Rect(npc1_x, npc1_y,
                                npc1_shot_left[0].get_width(),
                                npc1_shot_left[0].get_height())

        for npc in npc_list_in_game[:]:
            npc.update()
            # Создаем Rect для текущего NPC


            # Проверка столкновения с пулями
            for bullet in player_bullets[:]:
                bullet_rect = pygame.Rect(bullet['x'], bullet['y'], 10, 5)
                if bullet_rect.colliderect(npc.rect):
                    npc.hp -= 50
                    player_bullets.remove(bullet)

            # Логика состояний NPC
            if npc.hp <= 0:
                npc.state = "dead"

            if npc.state == "dead":
                screen.blit(npc2_dead_left[npc.death_anim_count // 10 % len(npc2_dead_left)],
                            (npc.x, npc.y))
                npc.death_anim_count += 1
                if npc.death_anim_count >= 10 * len(npc2_dead_left):
                    npc_list_in_game.remove(npc)
                continue

            # Определение поведения
            if player_rect.colliderect(npc.rect):
                npc.state = "attack"
            elif abs(npc.x - player_x) < 800:
                npc.state = "run"
            else:
                npc.state = "idle"

            # Обработка состояний
            if npc.state == "attack":
                screen.blit(npc2_attack_left[npc.attack_anim_count // 10 % len(npc2_attack_left)],
                            (npc.x, npc.y))
                npc.attack_anim_count += 1
                if damage_cooldown == 0:
                    hp -= 10
                    damage_cooldown = 30

            elif npc.state == "run":
                screen.blit(npc2_run_left[npc.run_anim_count // 10 % len(npc2_run_left)],
                            (npc.x, npc.y))
                npc.x -= 5
                npc.update()
                npc.run_anim_count += 1

            else:  # idle
                screen.blit(npc2_idle_left[0], (npc.x, npc.y))

            # Удаление NPC за пределами экрана
            if npc.x < -100:
                npc_list_in_game.remove(npc)

        npc_alive = 1
        if npc1_x < player_x - 150:
            npc1_left_pos = 2
            npc1_x_move = 2
        elif npc1_x > player_x:
            npc1_left_pos = 1
            npc1_x_move = 1

        if npc_health <= 0:
            npc_alive = 2  # Устанавливаем состояние "мертв"
            npc1_shot_anim_count = 0  # Сбрасываем счетчик анимации

        if npc_alive == 1:
            npc1_shoot_timer += 1
            if npc1_shoot_timer >= 60:  # 4 секунды при 60 FPS
                npc1_shoot_timer = 0
                is_npc1_shooting = True
                npc1_shot_anim_count = 0
                bullet_active = True
                if npc1_x_move == 1:
                    bullet_x = npc1_x - 25  # Начальная позиция пули
                elif npc1_x_move == 2:
                    bullet_x = npc1_x + 25
                bullet_y = 426  # Позиция по Y

            if is_npc1_shooting:
                npc1_shot_anim_count += 1
                if npc1_x_move == 1:
                    screen.blit(npc1_shot_left[npc1_shot_anim_count % len(npc1_shot_left)], (npc1_x, 390))
                elif npc1_x_move == 2:
                    screen.blit(npc1_shot_right[npc1_shot_anim_count % len(npc1_shot_left)], (npc1_x, 390))
                if npc1_shot_anim_count >= 60:
                    is_npc1_shot = False
            else:
                if npc1_left_pos == 1:
                    screen.blit(npc1_walk_left[player_anim_count % len(npc1_walk_left)], (npc1_x, 390))
                elif npc1_left_pos == 2:
                    screen.blit(npc1_idle_right[0], (npc1_x, 390))

        if bullet_active:
            if npc1_x_move == 2:
                bullet_x += 15
            elif npc1_x_move == 1:
                bullet_x -= 15
            screen.blit(bullet_surface, (bullet_x, bullet_y))
            shot1_sound = pygame.mixer.Sound('sound/shot_2.mp3')
            shot1_sound.set_volume(0.25)
            shot1_sound.play()

            bullet_rect = pygame.Rect(bullet_x, bullet_y, 10, 5)

            if bullet_rect.colliderect(player_rect):
                hp -= 25
                bullet_active = False
            if npc1_x > player_x:
                if bullet_x < player_x - 90:
                    bullet_active = False
            if bullet_x > 1500:
                bullet_active = False

        current_time = pygame.time.get_ticks()
        mouse_buttons = pygame.mouse.get_pressed()

        if mouse_buttons[0] and not is_player_shooting and current_time - last_shot_time > shot_cooldown:
            last_shot_time = current_time
            is_player_shooting = True
            player_shot_anim_count = 0

            shot2_sound = pygame.mixer.Sound('sound/shot.mp3')
            shot2_sound.set_volume(0.7)
            shot2_sound.play()

        if is_player_shooting:
            player_shot_anim_count += 1
            anim_speed = 2
            current_frame = player_shot_anim_count // anim_speed

            mouse_x, mouse_y = pygame.mouse.get_pos()
            direction = -1 if mouse_x < player_x else 1

            if current_frame == bullet_spawn_frame and len(player_bullets) == 0:
                player_bullets.append({
                    'surface': bullet_surface,
                    'x': player_x + (50 if direction == 1 else -10),
                    'y': player_y + 20,
                    'direction': direction
                })

            # Отрисовка анимации выстрела
            if direction == -1:  # Влево
                if current_frame < len(shot_left):
                    screen.blit(shot_left[current_frame], (player_x, player_y))
                else:
                    is_player_shooting = False
            else:  # Вправо
                if current_frame < len(shot):
                    screen.blit(shot[current_frame], (player_x, player_y))
                else:
                    is_player_shooting = False
        else:

            if keys[pygame.K_z]:
                screen.blit(atack[player_anim_count % len(atack)], (player_x, player_y))
                player_anim_count += 1


            elif keys[pygame.K_x]:
                is_shot = True
                if player_anim_count < len(shot):
                    screen.blit(shot[player_anim_count], (player_x, player_y))
                    player_anim_count += 1
                else:
                    player_anim_count = 0



            elif keys[pygame.K_SPACE]:
                screen.blit(jump[player_anim_count % len(jump)], (player_x, player_y))




            elif keys[pygame.K_d]:
                if keys[pygame.K_LSHIFT]:
                    screen.blit(run_right[player_anim_count % len(run_right)], (player_x, player_y))
                else:
                    screen.blit(walk_right[player_anim_count % len(walk_right)], (player_x, player_y))
                player_anim_count += 1

            elif keys[pygame.K_a]:
                if keys[pygame.K_LSHIFT]:
                    screen.blit(run_left[player_anim_count % len(run_left)], (player_x, player_y))
                else:
                    screen.blit(walk_left[player_anim_count % len(walk_left)], (player_x, player_y))
                    player_anim_count += 1
            else:
                screen.blit(stay[0], (player_x, player_y))

            if keys[pygame.K_a] and player_x > 50:
                player_x -= player_speed
                bg_scroll += scroll_speed
                if keys[pygame.K_LSHIFT] and player_x < 1300:
                    player_x += player_speed * -0.5
                    bg_scroll -= scroll_speed * -2
            elif keys[pygame.K_d] and player_x < 1300:
                player_x += player_speed
                bg_scroll -= scroll_speed
                if keys[pygame.K_LSHIFT] and player_x < 1300:
                    player_x += player_speed * 0.5
                    bg_scroll -= scroll_speed * 2

        for bullet in player_bullets[:]:

            bullet['x'] += 15 * bullet['direction']  # Движение пули
            screen.blit(bullet_surface, (bullet['x'], bullet['y']))

            # Проверка выхода за границы
            if bullet['x'] < -50 or bullet['x'] > 1500:
                bullet['active'] = False
                player_bullets.remove(bullet)
                continue

            bullet_rect = pygame.Rect(bullet['x'], bullet['y'], 15, 3)

            if bullet_rect.colliderect(npc1_rect):
                npc_health -= 35  # Наносим урон 35
                bullet['active'] = False
                player_bullets.remove(bullet)

        if npc_health <= 0 and npc_alive == 1:
            npc_alive = 2
            npc_death_anim_count = 0
            npc_death_timer = 0

        elif npc_alive == 2:

            npc_death_anim_count += 1
            current_frame = npc_death_anim_count // npc_death_frame_duration

            if current_frame < len(npc1_dead_left):
                screen.blit(npc1_dead_left[current_frame], (npc1_x, 390))

            else:

                npc_alive = 0  # Состояние "можно удалить"

    if not is_jump:
        if keys[pygame.K_SPACE]:
            is_jump = True
    else:
        if jump_count >= -7:
            if jump_count > 0:
                player_y -= (jump_count ** 2) / 2
            else:
                player_y += (jump_count ** 2) / 2
            jump_count -= 1
        else:
            is_jump = False
            jump_count = 7

    if player_anim_count == 9:
        player_anim_count = 0
    else:
        player_anim_count += 1

    if npc1_x_move == 1:
        if npc1_x > 1000:
            npc1_x -= 4

    if hp <= 0:
        screen.fill('Black')
        lose_text = font.render("ВЫ ПРОИГРАЛИ!", True, (255, 255, 255))
        screen.blit(lose_text, (600, 100))

    pygame.display.update()

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
            pygame.quit()
        if event.type == npc_timer and not menu:
            npc_list_in_game.append(NPC2(1500, 390))

    clock.tick(15)